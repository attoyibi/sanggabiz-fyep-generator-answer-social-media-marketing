# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# artefak skrip pemeriksaan
.render-*.mjs
.cek-*.mjs

# referensi desain pribadi (aset pihak ketiga, bukan milik proyek ini —
# jangan ikut di-deploy sebagai berkas statis publik)
/public/layout_reference/
